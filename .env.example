# agent-web-ui settings: the one place for all of them. scripts/init-env.sh copies
# this file to .env (gitignored) with generated passwords; change the values in .env.
# Who reads it: the programs read .env from the directory they run in; the scripts
# read it from the repository root (or the file --env names) and take from this file
# whatever .env lacks, so a setting you never changed still has its value here;
# Docker Compose reads .env itself. An empty value counts as unset (the default
# applies). A variable already in the environment wins over this file for the
# programs and for Compose; the scripts do not look at the environment (two hooks that
# tests use aside: ENV_EXAMPLE and LSOF), and a program one of them starts gets this
# file's values in its environment, over what was there.
# The scripts read this file with `.` as strictly as they run (set -eu), so keep it
# shell-safe: comments on their own lines, no unset $VARIABLE, and single quotes
# around any value that has spaces, &, ;, | or $ (double quotes let the shell expand a $).

# --- App ---------------------------------------------------------------------
# APP_ENV: development | test | production. Production needs an https APP_BASE_URL.
APP_ENV=development
# 127.0.0.1 keeps the page to this computer. Use :8300 (every interface) only
# behind a firewall or a TLS proxy: the page is plain http.
APP_HTTP_ADDR=127.0.0.1:8300
# Trusted origin for CSRF checks. An https URL turns on Secure cookies.
APP_BASE_URL=http://localhost:8300
# APP_LOG_LEVEL: debug | info | warn | error. APP_LOG_FORMAT: json | text
APP_LOG_LEVEL=info
APP_LOG_FORMAT=json
# Time allowed to finish or cancel in-flight streams on SIGTERM.
APP_SHUTDOWN_GRACE=10s
# A browser sends a character in up to 12 bytes: keep this at least
# 12 x CHAT_MAX_MESSAGE_CHARS + 4096, or the server refuses long messages.
HTTP_MAX_BODY_BYTES=131072
# How long a client has to send a request body, and to take a page it asked for.
# Event streams are not held to these.
HTTP_BODY_TIMEOUT=30s
HTTP_RESPONSE_TIMEOUT=2m

# --- Database (required) -----------------------------------------------------
# The password here must match POSTGRES_PASSWORD below. In the user and the
# password, write @ as %40, / as %2F, ? as %3F and # as %23: the server refuses
# a URL that has one of them there as it is.
DB_URL=postgres://agentwebui:change-me@localhost:5440/agentwebui?sslmode=disable
DB_MAX_CONNS=10
DB_MIGRATE_ON_START=true

# --- Agent (required) --------------------------------------------------------
# The agent the Web UI talks to. :9093 is the scripted test agent that Docker Compose
# runs (it echoes your message); :9094 is the real agent that scripts/real-agent.sh
# starts (see "Real agent" below).
AGENT_BASE_URL=http://localhost:9093/api
# AGENT_BASE_URL=http://localhost:9094/api
AGENT_APP_NAME=ui_agent
# Use 600s for GAIA runs: tool-using agents are slow. An ADK agent also ends a reply
# that has streamed for two minutes (its launcher's --sse-write-timeout), and the
# page then shows the reply cut off; scripts/real-agent.sh raises that to ten.
AGENT_REQUEST_TIMEOUT=120s

# --- Chat --------------------------------------------------------------------
CHAT_MAX_MESSAGE_CHARS=8000
CHAT_STREAM_FLUSH_INTERVAL=50ms
CHAT_LIST_LIMIT=100

# --- Rate limiting (per user on sends, per IP on login) ----------------------
RATE_LIMIT_RPS=2
RATE_LIMIT_BURST=10

# --- Sessions and first user -------------------------------------------------
SESSION_TTL=24h
# Creates the first user when no users exist. Set both or neither.
# ADMIN_PASSWORD needs at least 12 characters.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# --- Docker Compose (docker-compose.yml) --------------------------------------
# Used by `docker compose` and ignored by the program itself.
# POSTGRES_PASSWORD must match the password inside DB_URL above. Compose gives it
# to PostgreSQL as it is and writes it into the DB_URL of its web server as it is,
# so keep it to what a URL takes as it is: letters, digits, - . and _ (what
# scripts/init-env.sh generates is letters and digits). With @, /, ? or # in it
# that web server refuses to start, and a sign that is percent-encoded here is
# not the password that PostgreSQL was given.
POSTGRES_USER=agentwebui
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agentwebui
POSTGRES_PORT=5440
AGENT_PORT=9093
WEB_PORT=8300

# --- Scripted test agent (cmd/test-agent, the agent service of docker-compose.yml) --
# How fast its scripted replies stream. Raise the chunks for a long #slow reply
# (to stop one, or to scroll while one streams). `go run ./cmd/test-agent` reads
# them from here; Docker Compose passes the three delays on.
TEST_AGENT_WORD_DELAY=10ms
TEST_AGENT_SLOW_DELAY=100ms
TEST_AGENT_SLOW_CHUNKS=50
# A file that scripts the answers to the evaluator's self-test problems. The
# selftest profile of docker-compose.yml sets it for its own agent.
# TEST_AGENT_FIXTURE=

# --- Real agent (scripts/real-agent.sh) ----------------------------------------
# A real ADK agent for the Web UI and the evaluator to talk to: the ui-agent sample of
# the adk-training-go repository, on Gemini (hosted: every message goes to Google with
# the key below and counts against its quota). Point the Web UI at it (AGENT_BASE_URL
# above, port REAL_AGENT_PORT) and give it a long AGENT_REQUEST_TIMEOUT. Relative
# paths are relative to the repository root.
# The Gemini model. The sample's own default (adk-training-go,
# internal/infrastructure/llm/config.go) is named here so it isn't hidden in a
# repository this one doesn't control.
GEMINI_MODEL=gemini-3.5-flash
# The Gemini key, from Google AI Studio. The script hands it to the agent and never
# prints it. Unset: the agent looks for it itself, in its own .env and then in the
# environment. This file is private (mode 600) and git ignores it; the Web UI
# server gets every setting of it in its environment, and ignores this one.
# GOOGLE_AI_STUDIO_API_KEY=
# Where the samples are checked out, which sample under cmd/ to run, the application
# it serves, and its port (9093 is the scripted agent's).
ADK_TRAINING_DIR=../adk-training-go
REAL_AGENT=ui-agent
REAL_AGENT_APP=ui_agent
REAL_AGENT_PORT=9094
# The longest one reply may take to stream (a Go duration). The ADK launcher cuts a
# reply off after two minutes otherwise, and the page shows it cut off.
REAL_AGENT_SSE_TIMEOUT=10m
# The ADK to build the sample against, from a copy of its go.mod (the sample's files
# stay as they are). The sample pins 2.4, whose server listens on the whole network,
# and the script stops an agent that does; 2.5 and later listen on this computer
# only. This is the version go.mod uses. "sample": the version the sample pins.
REAL_AGENT_ADK=v2.5.0
# 1 keeps an agent that listens on the network: only on a network that is yours
# alone, or behind a firewall that blocks the port.
REAL_AGENT_ALLOW_LAN=0

# --- Evaluator (agent-eval) ----------------------------------------------------
# Needed only for `agent-eval datasets fetch`. Never logged or written anywhere.
# scripts/run.sh hands every setting in this file to the web server, this one
# included, so comment it out again once the dataset is downloaded.
# HF_TOKEN=
# The token is sent to these hosts, so they must be https (http only for this computer).
HF_DATASETS_SERVER_URL=https://datasets-server.huggingface.co
HF_HUB_URL=https://huggingface.co
# GAIA is gated: its terms forbid resharing. Keep these two directories out of git
# (the evaluator refuses to start when they are tracked).
HF_GAIA_DATASET=gaia-benchmark/GAIA
# Comma list of configs: 2023_level1, 2023_level2, 2023_level3 or 2023_all.
HF_GAIA_LEVELS=2023_level1
HF_DATASETS_DIR=./datasets
# validation has answers; test does not, so it can be asked but not graded.
GAIA_SPLIT=validation
# skip: leave out problems that come with a file. include: ask them anyway.
GAIA_ATTACHMENTS=skip
RESULTS_DIR=./results

# Where the Web UI is, and who to sign in as. Without EVAL_USER_*, the evaluator
# uses ADMIN_EMAIL and ADMIN_PASSWORD from above.
EVAL_BASE_URL=http://localhost:8300
# EVAL_USER_EMAIL=
# EVAL_USER_PASSWORD=

# Chrome DevTools MCP. The command must be npx on a pinned version, with no other
# package and no flag but -y, --yes, --no-install, --prefer-offline, -q, --quiet.
# The four flags below are required: they keep usage statistics and CrUX lookups
# off and the browser profile temporary. Words are split on spaces; there is no
# shell quoting.
EVAL_MCP_COMMAND="npx -y chrome-devtools-mcp@1.10.1"
EVAL_MCP_ARGS="--headless --isolated --no-usage-statistics --no-performance-crux"

# Keep this at or below AGENT_REQUEST_TIMEOUT.
EVAL_TASK_TIMEOUT=10m
EVAL_WORKERS=1
EVAL_REPEATS=1
# Used only with --human-typing.
EVAL_TYPING_DELAY=25ms
EVAL_KEEP_CHATS=false
# A file that replaces the built-in prompt template. It is tried when loaded, and
# must use {{.Question}} and nothing else.
# EVAL_PROMPT_FILE=
# What the probes that need a long reply ask. One line: it is typed by keystrokes.
# EVAL_PROBE_PROMPT=

# Limits the UI checks and probes judge against. Do not tune them to pass.
EVAL_UI_OVERHEAD_P95_MS=100
EVAL_STREAM_CHECK_MIN_CHARS=200
EVAL_MIN_STREAM_UPDATES=3
EVAL_SCROLL_FOLLOW_PX=80
EVAL_STOP_WITHIN_MS=1000
EVAL_LIGHTHOUSE_MIN_SCORE=90
EVAL_CLS_MAX=0.1

# --- Scripts and tools ---------------------------------------------------------
# The go command the scripts use. Unset: go on the PATH.
# GO=/usr/local/go/bin/go
# Where the scripts keep the binaries they build, their logs and process ids, and the
# quality tools that scripts/build-tools.sh builds (relative to the repository root;
# git ignores bin/ and logs/).
BIN_DIR=bin
LOG_DIR=logs
TOOLS_DIR=bin/tools
# scripts/check.sh: the coverage floors in percent (unit tests only, generated mocks
# left out) ...
COVER_CORE_MIN=85
COVER_ALL_MIN=70
COVER_PKG_MIN=50
# ... and the packages the unit tests cannot reach by design, which the integration
# tests cover (space separated).
COVER_EXEMPT="internal/app internal/infrastructure/postgres cmd/web cmd/test-agent internal/infrastructure/api/web/render/cmd/chromacss"

# --- Pull requests (scripts/pr-check.sh) ------------------------------------
# What a change goes into, for the size check.
PR_BASE=main
# A title is one of these, a colon and what changed: "fix: stop dropping the partial reply".
PR_PREFIXES="feat fix docs chore breaking refactor test ci"
# The longest title, so that lists do not cut it off.
PR_TITLE_MAX=80
# A change over either limit gets a warning: split it before asking for a review.
PR_MAX_LINES=500
PR_MAX_FILES=20

# --- Tests ---------------------------------------------------------------------
# 1 runs the live suite (go test ./it/live) against the real agent that AGENT_BASE_URL
# names. It may cost money and answers differently every time, so it is not part of the
# default run: it stays off until you set 1 here, and then it runs every time, with
# scripts/check.sh --it too, until you set it back to 0.
AGENT_LIVE=0
# How many attempts the opt-in measurement of UI overhead makes
# (go test ./it/evaldriver -run TestMeasureUIOverhead). 0 skips it.
EVAL_MEASURE=0
