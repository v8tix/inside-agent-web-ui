{{- /*
  The WHERE clause is the compare-and-set: of several callers at the same time
  only one still sees 'pending'. The last column is the user's message that the
  reply answers.
*/ -}}
UPDATE messages m SET status = 'streaming', updated_at = now()
FROM conversations c
WHERE m.id = $3 AND m.conversation_id = $2 AND c.id = m.conversation_id AND c.user_id = $1
  AND m.role = 'assistant' AND m.status = 'pending'
RETURNING {{template "sql/message/columns.gotmpl" -}}
  , COALESCE((SELECT u.content FROM messages u
              WHERE u.conversation_id = m.conversation_id AND u.role = 'user' AND u.seq < m.seq
              ORDER BY u.seq DESC LIMIT 1), '')
